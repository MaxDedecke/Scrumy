// Scrumy — Datenmodell
//
// Scrumy ist die interne Plattform des Beratungs-Startups: pro Kunde (Organization)
// laeuft ein Projekt, an dem ein virtuelles Team aus LLM-Agenten arbeitet wie ein
// echtes Dienstleister-Team.
//
// Pipeline: Kundenkorrespondenz (SupportRequest, z.B. per Jira/E-Mail-Connector)
// -> Support-Agent triagiert -> Product-Owner-Agent uebersetzt sie in Tickets im
// Backlog und priorisiert -> Planning-Agent plant ein Ticket (Feld `plan`) ->
// Coding-Agenten (Backend/Frontend/QA/DevOps) setzen um. Tickets durchlaufen dabei
// ein Scrum-Board (Backlog -> In Progress -> In Review -> Done), kritische
// Aenderungen brauchen ein menschliches Review, bevor sie beim Kunden deployt werden.
//
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Ein Kunde des Beratungs-Startups.
model Organization {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  createdAt DateTime @default(now())

  projects        Project[]
  connectors      Connector[]
  supportRequests SupportRequest[]

  @@map("organizations")
}

/// Eine Individualsoftware, die fuer einen Kunden gebaut/gewartet wird
/// (z.B. "Warenwirtschaft & CRM"). Verweist optional auf das eigene
/// Kunden-Repository, an dem die Agenten arbeiten.
///
/// Lebenszyklus (`status`): DISCOVERY (Anforderungen werden erfasst) ->
/// CONCEPT (Konzept wird ausgearbeitet, siehe `Concept`) -> ACTIVE (Konzept
/// freigegeben, Agenten-Team arbeitet nach Scrum) -> PAUSED/ARCHIVED. Jedes
/// neue Projekt startet in DISCOVERY, bevor ueberhaupt Tickets/Agenten
/// sinnvoll sind.
model Project {
  id                     String        @id @default(cuid())
  organizationId         String
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  description            String?
  repoUrl                String?
  status                 ProjectStatus @default(DISCOVERY)
  createdAt              DateTime      @default(now())
  /// Wann der Mensch die Anforderungsliste als vollstaendig freigegeben hat.
  /// Wird bei jeder Aenderung an den Anforderungen wieder auf null gesetzt –
  /// eine Freigabe gilt immer nur fuer die Liste, die geprueft wurde.
  requirementsApprovedAt DateTime?
  /// Verzeichnis des lokalen Git-Repos, in dem das Team arbeitet (im
  /// Workspace-Volume, siehe src/lib/workspace.ts). Wird beim Team-Start
  /// angelegt; solange null, hat das Team noch nie gearbeitet.
  workspacePath          String?
  /// Laeuft das Team selbststaendig weiter (naechster Sprint direkt nach dem
  /// Review) oder haelt es nach jedem Sprint an und wartet auf den Menschen?
  autopilot              Boolean       @default(true)
  /// Wie viele Sprints das Team ohne neue Entscheidung des Auftraggebers
  /// arbeiten darf. Ist das Budget aufgebraucht, beruft das Team eine Klaerung
  /// ein (siehe `Clarification`) statt einfach stehenzubleiben; der Mensch kann
  /// dort aufstocken.
  sprintBudget           Int           @default(12)

  /// Zustand der Frontend-Vorschau (siehe src/lib/preview.ts). Getrennt vom
  /// Projektstatus: die Vorschau wird von Hand gestartet/gestoppt und lebt nur
  /// im Speicher des App-Prozesses – nach einem Neustart des Containers ist
  /// jeder gemeldete Zustand hier veraltet und wird beim naechsten Lesen auf
  /// STOPPED zurueckgesetzt (siehe `getPreviewInfo`).
  previewStatus          PreviewStatus @default(STOPPED)
  previewPort            Int?
  /// Name/ID des laufenden Sibling-Containers dieser Vorschau (siehe
  /// src/lib/preview.ts) – Wahrheit ist immer `docker inspect`, dieses Feld
  /// ist nur der Schluessel dafuer, kein eigener Zustand.
  previewContainerId     String?
  /// Erkanntes Verzeichnis innerhalb des Repos, in dem der Dev-Server laeuft
  /// (z.B. das Repo-Wurzelverzeichnis oder ein `frontend/`-Unterordner).
  previewDir             String?
  /// Klartext des zuletzt verwendeten Start-Kommandos, fuer die Anzeige im
  /// Panel (z.B. "npm run dev").
  previewCommand         String?
  previewStartedAt       DateTime?
  previewError           String?

  requirements   Requirement[]
  concept        Concept?
  tickets        Ticket[]
  sprints        Sprint[]
  agents         AgentAssignment[]
  connectors     Connector[]
  activity       ActivityLogEntry[]
  agentRuns      AgentRun[]
  inquiries      TeamInquiry[]
  clarifications Clarification[]

  @@map("projects")
}

enum ProjectStatus {
  DISCOVERY
  CONCEPT
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Lebenszyklus der Frontend-Vorschau eines Projekts (siehe `Project.previewStatus`).
enum PreviewStatus {
  STOPPED
  STARTING
  RUNNING
  ERROR
}

/// Eine einzelne Anforderung fuer ein Projekt in der Discovery-Phase – entweder
/// manuell erfasst (Titel/Beschreibung) oder als Datei hochgeladen (z.B.
/// Lastenheft als PDF/Docx). Bildet zusammen die Grundlage fuer das `Concept`.
/// Datei-Inhalte liegen bewusst direkt in der DB (`fileData`, kein
/// Objektspeicher noetig fuer den aktuellen Umfang).
model Requirement {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    Priority          @default(MEDIUM)
  source      RequirementSource @default(MANUAL)
  fileName    String?
  fileType    String?
  fileData    Bytes?
  createdAt   DateTime          @default(now())

  @@map("requirements")
}

enum RequirementSource {
  MANUAL
  UPLOAD
  /// Vom Product-Owner-Agenten aus dem Konzept abgeleitet (Button
  /// "Anforderungen generieren"), noch nicht vom Menschen bestaetigt.
  GENERATED
}

/// Das aus den `Requirement`s erarbeitete Konzept fuer ein Projekt – aktuell
/// Freitext, den der Berater selbst verfasst/einfuegt (kein Konzept-Agent).
/// `content` ist immer der aktuelle Arbeitsstand; jede Freigabe friert ihn als
/// `ConceptVersion` ein. `finalizedAt` ist das Datum der letzten Freigabe.
model Concept {
  id          String        @id @default(cuid())
  projectId   String        @unique
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content     String
  status      ConceptStatus @default(DRAFT)
  finalizedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  versions ConceptVersion[]

  @@map("concepts")
}

enum ConceptStatus {
  DRAFT
  FINALIZED
}

/// Eingefrorener Stand des Konzepts zum Zeitpunkt einer Freigabe. Rein
/// additiv: Eine Version wird nie ueberschrieben, weiterarbeiten am Konzept
/// erzeugt bei der naechsten Freigabe die naechste Version. Damit ist
/// nachvollziehbar, welchen Text der Kunde wann freigegeben hat.
model ConceptVersion {
  id         String   @id @default(cuid())
  conceptId  String
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  version    Int
  content    String
  releasedAt DateTime @default(now())

  @@unique([conceptId, version])
  @@map("concept_versions")
}

/// Ein LLM-Agent mit einer bestimmten Rolle im virtuellen Team.
///
/// Pipeline-Rollen: SUPPORT (Kundenkorrespondenz) -> PRODUCT_OWNER (Tickets
/// erstellen/priorisieren) -> PLANNING (Ticket planen) -> BACKEND/FRONTEND/QA/DEVOPS
/// (umsetzen). REVIEWER unterstuetzt den menschlichen Review-Schritt.
///
/// Welches LLM ein Agent nutzt, ist bewusst NICHT hier fest verdrahtet, sondern
/// verweist auf ein global (beratungsweit, nicht pro Kunde) gepflegtes `LlmProfile`
/// – so lassen sich Cloud-LLMs und ein lokaler Ollama-Container zentral verwalten
/// und pro Agent zuweisen.
model Agent {
  id           String      @id @default(cuid())
  name         String
  role         AgentRole
  llmProfileId String?
  llmProfile   LlmProfile? @relation(fields: [llmProfileId], references: [id], onDelete: SetNull)
  status       AgentStatus @default(IDLE)
  createdAt    DateTime    @default(now())

  assignments          AgentAssignment[]
  ticketEvents         ActivityLogEntry[]
  supportRequests      SupportRequest[]
  runs                 AgentRun[]
  assignedTickets      Ticket[]           @relation("TicketAssignee")
  answeredInquiries    TeamInquiry[]
  raisedClarifications Clarification[]

  @@map("agents")
}

/// Globales, beratungsweites LLM-Profil (NICHT pro Kunde) – z.B. ein Cloud-Modell
/// oder ein lokal betriebener Ollama-Container. Wird Agenten zugewiesen.
model LlmProfile {
  id        String      @id @default(cuid())
  name      String
  provider  LlmProvider
  model     String // z.B. "claude-sonnet-5" oder "llama3.1:70b"
  baseUrl   String? // z.B. http://ollama:11434 fuer einen lokalen Container
  apiKeyRef String? // Verweis auf Secret-Store/env, nie der Key selbst
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())

  agents Agent[]

  @@map("llm_profiles")
}

enum LlmProvider {
  ANTHROPIC
  OPENAI
  OLLAMA
  GENERIC_OPENAI_COMPAT
}

enum AgentRole {
  SUPPORT
  PRODUCT_OWNER
  PLANNING
  BACKEND
  FRONTEND
  QA
  REVIEWER
  DEVOPS
  /// Haelt den Scrum-Ablauf zusammen: Sprint-Review, Standup-Zusammenfassung
  /// und Rede und Antwort gegenueber dem Menschen (siehe `TeamInquiry`).
  SCRUM_MASTER
}

enum AgentStatus {
  IDLE
  WORKING
  BLOCKED
}

/// Verknuepft Agenten mit Projekten (ein Agent kann an mehreren Kundenprojekten
/// mitarbeiten, ein Projekt hat mehrere Agenten im Team). `connector` ist die
/// Konfiguration, mit der DIESER Agent in DIESEM Projekt arbeitet – z.B. der
/// Support-Agent mit dem Jira-Connector des Kunden, der DevOps-/Backend-Agent mit
/// dem Git-Connector des Projekt-Repos.
model AgentAssignment {
  id          String     @id @default(cuid())
  agentId     String
  agent       Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectorId String?
  connector   Connector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@unique([agentId, projectId])
  @@map("agent_assignments")
}

/// Ein angebundenes externes System (Jira, andere PM-Tools, E-Mail-Postfach, Git-
/// Repository, ...), ueber das Agenten automatisiert arbeiten – z.B. der Support-
/// Agent liest/schreibt Kundenkorrespondenz per Jira-Connector, der DevOps-/
/// Backend-Agent committet ueber einen Git-Connector im Projekt-Repo.
/// `organizationId` ordnet den Connector immer einem Kunden zu; `projectId` grenzt
/// ihn zusaetzlich auf ein einzelnes Projekt ein (z.B. Git-Connector = 1 Repo),
/// bleibt bei kundenweiten Connectoren (z.B. das eine Jira-Postfach) leer.
/// `config` enthaelt nicht-geheime Verbindungsdaten (Base-URL, Projekt-Key,
/// Repo-URL, Branch, ...); Zugangsdaten liegen bewusst nicht in der DB, sondern
/// werden ueber `credentialRef` auf einen Secret-Store/env verwiesen.
model Connector {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider       ConnectorProvider
  name           String
  config         Json?
  credentialRef  String?
  status         ConnectorStatus   @default(ACTIVE)
  createdAt      DateTime          @default(now())

  supportRequests  SupportRequest[]
  agentAssignments AgentAssignment[]

  @@map("connectors")
}

enum ConnectorProvider {
  JIRA
  ZENDESK
  EMAIL
  GIT
  GENERIC_WEBHOOK
}

enum ConnectorStatus {
  ACTIVE
  INACTIVE
  ERROR
}

/// Eine eingehende Kundenanfrage (Feature-Request, Bug-Report, allgemeine
/// Korrespondenz) – kommt manuell oder automatisiert ueber einen Connector rein.
/// Der Support-Agent triagiert sie; der Product-Owner-Agent uebersetzt sie in ein
/// oder mehrere Tickets (siehe `Ticket.sourceRequest`).
model SupportRequest {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorId    String?
  connector      Connector?           @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  channel        SupportChannel
  externalRef    String? // z.B. Jira-Issue-Key oder E-Mail-Message-ID
  fromContact    String?
  subject        String?
  body           String
  status         SupportRequestStatus @default(NEW)
  handledById    String?
  handledBy      Agent?               @relation(fields: [handledById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tickets       Ticket[]
  activity      ActivityLogEntry[]
  clarification Clarification?

  @@map("support_requests")
}

enum SupportChannel {
  EMAIL
  JIRA
  CHAT
  PORTAL
  PHONE_NOTE
}

enum SupportRequestStatus {
  NEW
  TRIAGED
  CONVERTED
  CLOSED
}

/// Ein Feature-Request, Bug oder eine Integrationsaufgabe auf dem Scrum-Board
/// eines Projekts. `plan` ist das Arbeitsfeld des Planning-Agents, bevor
/// Coding-Agenten loslegen. `externalRef` verweist auf das verknuepfte Ticket im
/// Kunden-System (z.B. Jira-Key), damit Status automatisiert zurueckgespiegelt
/// werden kann.
model Ticket {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceRequestId String?
  sourceRequest   SupportRequest? @relation(fields: [sourceRequestId], references: [id], onDelete: SetNull)
  sprintId        String?
  sprint          Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Der Agent, der dieses Ticket umsetzt (Sprint-Planung verteilt die Arbeit
  /// anhand der Rolle, genau wie ein Team seine Tickets zieht).
  assigneeId      String?
  assignee        Agent?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  plan            String? // Planning-Agent: geplante Umsetzungsschritte
  /// Abschlussbericht des umsetzenden Agenten: was er geaendert hat und warum.
  result          String?
  /// Story Points aus der Sprint-Planung.
  estimate        Int?
  type            TicketType      @default(FEATURE)
  status          TicketStatus    @default(BACKLOG)
  priority        Priority        @default(MEDIUM)
  requestedBy     String? // Name/Kontakt des Kunden, der die Anfrage gestellt hat
  isCritical      Boolean         @default(false) // erzwingt menschliches Review vor Deploy
  externalRef     String? // z.B. verknuepfter Jira-Issue-Key beim Kunden
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  reviews        ReviewApproval[]
  activity       ActivityLogEntry[]
  runs           AgentRun[]
  clarifications Clarification[]

  @@map("tickets")
}

/// Ein Sprint im Projekt. Die Sprint-Planung (Product-Owner-Agent) schneidet
/// aus Konzept + Anforderungen die naechsten Tickets, der Sprint-Review
/// (Scrum-Master-Agent) schliesst ihn mit einer Zusammenfassung ab. Sprints
/// sind fortlaufend nummeriert und bleiben als Historie stehen – daran laesst
/// sich spaeter ablesen, was das Team wann geliefert hat.
model Sprint {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  goal      String
  status    SprintStatus @default(PLANNED)
  /// Review-Text des Scrum-Master-Agenten am Sprint-Ende.
  summary   String?
  startedAt DateTime     @default(now())
  endedAt   DateTime?

  tickets        Ticket[]
  runs           AgentRun[]
  clarifications Clarification[]

  @@unique([projectId, number])
  @@map("sprints")
}

enum SprintStatus {
  PLANNED
  ACTIVE
  REVIEW
  DONE
}

/// Ein einzelner Arbeitsschritt eines Agenten – die Belegebene fuer alles, was
/// das Team tut: welcher Agent mit welchem Modell welche Frage gestellt bekam
/// (`systemPrompt`/`prompt`) und was er geantwortet hat (`response`). Damit ist
/// jede Ticket-Planung, jede Code-Aenderung und jede Auskunft an den Menschen
/// im Nachhinein pruefbar, statt nur das Ergebnis zu sehen.
model AgentRun {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  ticketId     String?
  ticket       Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  sprintId     String?
  sprint       Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Art des Schritts: kickoff, sprint_planning, ticket_plan, implementation,
  /// review, sprint_review, inquiry.
  kind         String
  /// Kurzbeschreibung fuer die Live-Ansicht ("Plant Ticket „Login-Maske"").
  headline     String
  status       RunStatus @default(RUNNING)
  llmProfileId String?
  model        String?
  systemPrompt String
  prompt       String
  response     String?
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  durationMs   Int?

  @@index([projectId, startedAt])
  @@map("agent_runs")
}

enum RunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Eine Frage des Menschen an das Team ("Wie ist der Stand?", "Warum habt ihr
/// X so geloest?") und die Antwort des Scrum-Master-Agenten, der dafuer den
/// echten Projektstand (Sprints, Tickets, Commits, Aktivitaeten) heranzieht.
/// Bleibt als Gespraechsverlauf stehen – wie das Protokoll eines Gesprächs im
/// Buero des Teams.
model TeamInquiry {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question     String
  answer       String?
  status       InquiryStatus @default(PENDING)
  answeredById String?
  answeredBy   Agent?        @relation(fields: [answeredById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  answeredAt   DateTime?

  @@map("team_inquiries")
}

enum InquiryStatus {
  PENDING
  ANSWERED
  FAILED
}

/// Eine Klaerung: das Team kommt an einer Stelle allein nicht weiter und
/// beruft den Auftraggeber ein – die Gegenrichtung zu `TeamInquiry`.
///
/// Der Grund fuer dieses Modell: Frueher endete jede Sackgasse (abgestuerzter
/// Modellaufruf, widerspruechliche Anforderung, leerer Backlog) in einem
/// Protokolleintrag, und die Arbeit stand still, ohne dass es jemandem auffiel.
/// Eine Klaerung macht daraus einen sichtbaren Vorgang mit Frage, Optionen und
/// Beschluss – und traegt in `resumeTask`/`resumePayload` den eingefrorenen
/// Arbeitsschritt mit sich, der nach dem Beschluss genau dort weiterlaeuft, wo
/// das Team stehengeblieben ist.
///
/// `scope` entscheidet, wie weit die Blockade reicht: TICKET legt eine Story
/// still (das Team zieht die naechste), SPRINT den laufenden Sprint, PROJECT
/// die ganze Mannschaft.
model Clarification {
  id         String  @id @default(cuid())
  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticketId   String?
  ticket     Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sprintId   String?
  sprint     Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  /// Welcher Agent die Klaerung einberufen hat (null = Scrumy selbst, z.B. bei
  /// einem abgestuerzten Schritt).
  raisedById String?
  raisedBy   Agent?  @relation(fields: [raisedById], references: [id], onDelete: SetNull)

  scope   ClarificationScope @default(TICKET)
  /// Maschinenlesbarer Anlass: step_failed, step_abandoned, no_changes,
  /// qa_needs_decision, agent_blocker, no_agent, no_workspace, backlog_empty,
  /// sprint_budget. Dient auch der Entdopplung offener Klaerungen.
  trigger String
  /// Was entschieden werden muss – in einem Satz, aus Sicht des Auftraggebers.
  question String
  /// Beleglage: Fehlermeldung, QA-Kommentar, Zusammenfassung des Agenten.
  context  String?
  /// Vorschlaege des Teams: [{ key, label, detail, effect }]. `effect` steuert,
  /// was der Beschluss ausloest (resume | skip | stop | budget).
  options  Json?
  /// Einordnung und Empfehlung des Scrum Masters (siehe clarificationPrep).
  agenda   String?

  status    ClarificationStatus @default(OPEN)
  decision  String?
  decidedBy String?
  decidedAt DateTime?

  /// Der eingefrorene Arbeitsschritt, der nach dem Beschluss wieder eingereiht
  /// wird (Task-Name + Payload aus der Job-Queue). Ohne ihn bestimmt Scrumy den
  /// naechsten Schritt aus dem Projektstand.
  resumeTask    String?
  resumePayload Json?

  /// An den Kunden weitergereicht: Die Frage laeuft dann als Vorgang im
  /// Support-Postfach, die Antwort kommt ueber denselben Vorgang zurueck.
  forwardedAt        DateTime?
  forwardedRequestId String?         @unique
  forwardedRequest   SupportRequest? @relation(fields: [forwardedRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([projectId, status])
  @@map("clarifications")
}

enum ClarificationScope {
  TICKET
  SPRINT
  PROJECT
}

enum ClarificationStatus {
  OPEN
  DECIDED
  WITHDRAWN
}

enum TicketType {
  FEATURE
  BUG
  INTEGRATION
  CHORE
}

enum TicketStatus {
  BACKLOG
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Menschlicher Freigabe-Schritt fuer kritische Aenderungen, bevor ein Ticket
/// als DONE gilt bzw. beim Kunden deployt wird.
model ReviewApproval {
  id           String         @id @default(cuid())
  ticketId     String
  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  reviewerName String
  decision     ReviewDecision @default(PENDING)
  comment      String?
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())

  @@map("review_approvals")
}

enum ReviewDecision {
  PENDING
  APPROVED
  REJECTED
}

/// Audit-Trail: was hat welcher Agent (oder Mensch) getan – an einem Ticket,
/// einer Kundenanfrage und/oder projektweit (z.B. Konzept freigegeben, Team
/// gestartet). Macht die Arbeit des Agenten-Teams fuer den Kunden
/// nachvollziehbar.
model ActivityLogEntry {
  id               String          @id @default(cuid())
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticketId         String?
  ticket           Ticket?         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  supportRequestId String?
  supportRequest   SupportRequest? @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  agentId          String?
  agent            Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  actor            String // Anzeigename, falls kein Agent (z.B. "Mensch: Max")
  action           String // z.B. "status_changed", "code_committed", "comment", "request_received"
  detail           String?
  createdAt        DateTime        @default(now())

  @@map("activity_log_entries")
}
