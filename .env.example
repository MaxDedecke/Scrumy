# Lokale Entwicklung (Postgres läuft via `docker compose up db` auf localhost:5433):
DATABASE_URL="postgresql://scrumy:scrumy@localhost:5433/scrumy?schema=public"

# GitHub Fine-grained Personal Access Token oder GitHub-App-Token mit
# Contents: Read and write fuer die Kunden-Repositories. Scrumy speichert ihn
# nicht in der DB; Git-Connectoren verweisen bei Bedarf mit env:GITHUB_TOKEN
# lediglich auf diese Variable.
GITHUB_TOKEN=""

# Optional: getrennte Tokens pro Projekt/Kunde. Der jeweilige Git-Connector
# verweist dann nur auf den Namen, z.B. env:KUNDE_A_GITHUB_TOKEN. Der Worker
# übernimmt neue Variablennamen automatisch aus .env; docker-compose.yml muss
# dafür nicht pro Repository erweitert werden.
# KUNDE_A_GITHUB_TOKEN=""
# KUNDE_B_GITHUB_TOKEN=""

# Verschlüsselt Connector-Zugangsdaten, die jemand direkt ins UI-Formular
# tippt (Alternative zu einer env:NAME-Referenz oben, ohne Server-Zugriff
# nutzbar) – siehe src/lib/secret.ts. Einmalig generieren, z.B.:
#   openssl rand -base64 32
# Danach NICHT mehr ändern, sonst lassen sich bereits gespeicherte Token nicht
# mehr entschlüsseln. Pflicht, sobald mindestens ein Connector einen direkt
# eingegebenen Token (statt env:NAME) verwendet.
CREDENTIAL_ENCRYPTION_KEY=""

# Optional nur fuer `npm run db:seed`: Ohne URL arbeitet das Demo-Projekt
# absichtlich in einem lokalen Repository.
DEMO_REPO_URL=""

# Nur für den "ollama"-Service (docker-compose.yml, Profile "ollama" - z.B. auf
# einem RunPod-GPU-Pod, siehe README "RunPod-Deployment"): Modell, das beim
# Start automatisch gepullt wird. Muss zum Namen passen, unter dem das
# LlmProfile in den Einstellungen angelegt wird (Feld "Modell").
OLLAMA_MODEL="llama3.1:8b"
